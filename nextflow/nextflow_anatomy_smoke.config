// Dynamic source-run profile used by scripts/run_SMN4Lang_anatomy_smoke.sh.
includeConfig "nextflow.config"

params.megflow.output_dir = System.getenv("MEGFLOW_SMOKE_OUTPUT_DIR")
params.megflow.corpus_root = ""
params.megflow.dataset_include = ["SMN4Lang_anatomy_smoke"]
params.megflow.dataset_exclude = []
params.megflow.report_scope = "dataset"
params.megflow.datasets = [
    SMN4Lang_anatomy_smoke: [
        dataset_dir: System.getenv("MEGFLOW_SMOKE_DATASET_DIR"),
        output_dir: System.getenv("MEGFLOW_SMOKE_OUTPUT_DIR"),
        preproc_dir: "${System.getenv('MEGFLOW_SMOKE_OUTPUT_DIR')}/preprocessed",
        fs_subjects_dir: System.getenv("MEGFLOW_SMOKE_FS_SUBJECTS_DIR"),
        t1_dir: System.getenv("MEGFLOW_SMOKE_DATASET_DIR"),
        steps: "anatomy",
        mri_import: [subject_id: [System.getenv("MEGFLOW_SMOKE_SUBJECT_ID")]],
        anatomy: [
            method: System.getenv("MEGFLOW_SMOKE_ANATOMY_BACKEND") ?: "freesurfer",
            is_bids: true
        ],
        report: [static_task_log_mode: "none"]
    ]
]

workDir = "${System.getenv('MEGFLOW_SMOKE_OUTPUT_DIR')}/work"
log.file = "${System.getenv('MEGFLOW_SMOKE_OUTPUT_DIR')}/static_html_report/nextflow/nextflow.log"
report.file = "${System.getenv('MEGFLOW_SMOKE_OUTPUT_DIR')}/static_html_report/nextflow/report.html"
timeline.file = "${System.getenv('MEGFLOW_SMOKE_OUTPUT_DIR')}/static_html_report/nextflow/timeline.html"
trace.file = "${System.getenv('MEGFLOW_SMOKE_OUTPUT_DIR')}/static_html_report/nextflow/trace.txt"
