// Docker/Singularity MEGFlow Dataset Profile System configuration.
// This file is copied into the image as /program/nextflow/nextflow.config.

params {
    megflow {
        code_dir = "/program/megflow"
        output_dir = "/output"
        report_scope = "dataset"
        corpus_root = ""
        dataset_include = []
        dataset_exclude = []
        error_mode = "lenient"

        execution {
            local_cpus = "auto"
            local_memory = "auto"
            local_max_tasks = "auto"
        }

        defaults {
            steps = "meg_all"
            dataset_format = "auto"
            file_suffix = ".fif"
            is_bids = true
            visualize = true
            // Shared default for covariance and source; explicit function rank keys override it.
            rank_policy = "auto"

            seeds {
                osl = 2025
                ica = 2025
            }

            anatomy {
                method = "freesurfer"
                is_bids = true
                select_tag = ""
                t1_input_type = "nifti"
                t1_dicom_series_glob = ""
                fs_license_file = "/fs_license.txt"
                pseudomri_template_dir = "/program/megflow/tools/pseudomri"
                pseudomri_template_subject = "mni_icbm152_nlin_sym_09a"
                deepprep_device = "cpu"
            }

            mri_import {
                subject_id = null
                session_id = null
                task = null
                run_id = null
            }

            meg_import {
                subject_id = null
                session_id = null
                task = null
                run_id = null
                raw_include_keywords = null
                raw_exclude_keywords = null
            }

            megqc {
                enabled = true
                min_score = 0.0
                alarm_score = 70.0
                meg_vendor = "auto"
                category = "auto"
                reference_scope = "device_category"
                min_reference_n = 20
                freq_max_samples = 0
                dfa_max_samples = 20000
                dfa_method = "msqms"
                skip_dfa = false
                keep_bad_annotations = true
                omit_bad_channels = false
                seg_length = 100
                preproc = [
                    [filter: [l_freq: 1.0, h_freq: 100.0, method: "iir", iir_params: [order: 5, ftype: "butter"]]],
                    [notch_filter: [freqs: 50]],
                    [resample: [sfreq: 250]]
                ]
            }

            preproc {
                steps = [
                    [filter: [l_freq: 1.0, h_freq: 100.0, method: "iir", iir_params: [order: 5, ftype: "butter"]]],
                    [notch_filter: [freqs: "50 100"]],
                    [resample: [sfreq: 250]]
                ]
            }

            digitization {
                enabled = true
                coordsystem_file_pattern = "{prefix}_coordsystem.json"
                hsp_file_pattern = "{prefix}_headshape.pos"
                elp_file_pattern = null
            }

            artifacts {
                deepreject {
                    enabled = true
                    mode = "default"
                    device = "cpu"
                    category = "auto"
                    pick_meg_only = true
                    pick_exclude_marked_bads = false
                    keep_meg_only_input = false
                    run_bad_segments = true
                    run_bad_channels = true
                    on_error = "warn"
                    preproc = [
                        [filter: [l_freq: 1.0, h_freq: 100.0, method: "iir", iir_params: [order: 5, ftype: "butter"]]],
                        [notch_filter: [freqs: 50]],
                        [resample: [sfreq: 250]]
                    ]
                    fold_workers = "auto"
                    cache_models = true
                    cpu_threads = "auto"
                    cpu_interop_threads = 1
                    badsegnet_batch_size = 32
                }
                find_bad_channels {
                    pyprep {
                        deviation = [deviation_threshold: 5.0]
                        snr = [:]
                        nan_flat = [:]
                    }
                    psd = [std_multiplier: 6]
                    osl = [ref_meg: "auto", significance_level: 0.05]
                    mne {
                        find_bad_channels_lof {
                            n_neighbors = 20
                            picks = "mag"
                            metric = "euclidean"
                            threshold = 1.5
                        }
                    }
                }
                find_bad_segments {
                    keep_existing_annotations = false
                    osl = [segment_len: 1000]
                }
                interpolate_bads = false
                artifact_images_enabled = false
                artifact_image_n_jobs = "auto"
                meg_vendor = "auto"
            }

            ica {
                num_components = 0.9999
                compute_explained_variance = false
            }

            ic_label {
                ic_ecg = true
                ic_eog = true
                ic_outlier = false
                mne_icalabel = true
                megnet_retrained = false
                mne_algorithm = true
                rules_algorithm = true
                find_bads_eog {
                    ch_name = null
                    threshold = "auto"
                    l_freq = 1
                    h_freq = 10
                    start = null
                    stop = null
                    measure = "zscore"
                }
                find_bads_ecg {
                    ch_name = null
                    threshold = "auto"
                    method = "ctps"
                    l_freq = 8
                    h_freq = 16
                    measure = "zscore"
                }
                find_bads_muscle {
                    threshold = 0.5
                    start = null
                    stop = null
                    l_freq = 7
                    h_freq = 45
                }
                ICA_classify {
                    meg_vendor = "auto"
                    explained_var {
                        threshold = 0.1
                        ch_type = "mag"
                    }
                }
            }

            epochs {
                preproc = []
                task_type = "task"
                resting {
                    fixed_length_duration = 2.0
                }
                event_source = "event_file"
                event_time_shift_sec = 0.0
                autoreject = false
                interpolate_bads = false
                drop_bad_channels = false
                event_file {
                    trial_type = null
                }
                find_events {
                    stim_channel = null
                    shortest_event = 1
                    min_duration = 0.0
                }
                epochs {
                    event_id = 1
                    tmin = -0.2
                    tmax = 0.8
                    reject_by_annotation = true
                    picks = "meg"
                    baseline = [null, 0.0]
                    reject = [mag: 4e-12]
                    preload = true
                    detrend = null
                }
            }

            bem {
                ico = 4
                conductivity = [0.3]
            }

            coreg {
                visualize = true
                omit_head_shape_points = 1
                grow_hair = 0.0
                icp {
                    n_iterations = 200
                    lpa_weight = 1.0
                    nasion_weight = 10.0
                    rpa_weight = 1.0
                    hsp_weight = 10.0
                    eeg_weight = 0.0
                    hpi_weight = 1.0
                }
                finetune_icp {
                    n_iterations = 200
                    lpa_weight = 0.0
                    nasion_weight = 0.0
                    rpa_weight = 0.0
                    hsp_weight = 10.0
                    eeg_weight = 0.0
                    hpi_weight = 0.0
                }
            }

            covariance {
                visualize = true
                type = "epochs"
                raw_covariance_task_id = "emptr"
                event_time_shift_sec = 0.0
                compute_raw_covariance {
                    tmin = 0
                    tmax = null
                    method = "auto"
                    reject = [mag: 4e-12]
                    reject_by_annotation = true
                }
                events {
                    stim_channel = null
                    shortest_event = 1
                    min_duration = 0.0
                }
                epochs {
                    event_id = 1
                    tmin = -0.2
                    tmax = 0.0
                    picks = "mag"
                    baseline = null
                    preload = true
                    detrend = null
                    reject_by_annotation = true
                }
                covariance {
                    tmin = null
                    tmax = null
                }
            }

            forward {
                epoch_label = "wdonset"
                surface = "white"
                spacing = "ico4"
            }

            source {
                type = "epochs"
                visualize = true
                source_methods = ["dSPM"]
                data_type = "meg"
                spacing = "ico4"
                epoch_label = "wdonset"
                visualization {
                    mode = "peak"
                    hemi = "both"
                    views = "lateral"
                }
                dSPM {
                    inverse_operator {
                        loose = "auto"
                        depth = 0.8
                        fixed = "auto"
                    }
                    apply_inverse {
                        lambda2 = 0.1111111111111111
                        method = "dSPM"
                        pick_ori = "normal"
                    }
                }
                LCMV {
                    data_covariance {
                        tmin = 0.01
                        tmax = 0.4
                        method = "auto"
                    }
                    make_lcmv {
                        reg = 0.05
                        pick_ori = null
                        weight_norm = "unit-noise-gain-invariant"
                    }
                }
            }

            report {
                bad_channel_threshold = 30
                bad_segment_threshold = 50
                coreg_mean_threshold = 5.0
                coreg_max_threshold = 20.0
                epoch_reject_rate_threshold = 0.90
                static_artifact_overview_duration = 200.0
                alert_missing_ecg_components = true
                alert_missing_eog_components = true
                static_task_log_mode = "all-command-log"
            }
        }

        datasets {
            docker_input {
                name = "docker_input"
                dataset_dir = "/input"
                output_dir = "/output"
                preproc_dir = "/output/preprocessed"
                fs_subjects_dir = "/smri"
                t1_dir = "/input"
            }
        }
    }
}

workDir = "${params.megflow.output_dir}/work"

log {
    // run_for_docker.sh passes this path through Nextflow's top-level -log flag.
    file = "${params.megflow.output_dir}/${params.megflow.report_scope == 'corpus' ? 'corpus_static_html_report' : 'static_html_report'}/nextflow/nextflow.log"
    level = "INFO"
}

report {
    enabled = true
    file = "${params.megflow.output_dir}/${params.megflow.report_scope == 'corpus' ? 'corpus_static_html_report' : 'static_html_report'}/nextflow/report.html"
    overwrite = true
}

timeline {
    enabled = true
    file = "${params.megflow.output_dir}/${params.megflow.report_scope == 'corpus' ? 'corpus_static_html_report' : 'static_html_report'}/nextflow/timeline.html"
    overwrite = true
}

trace {
    enabled = true
    file = "${params.megflow.output_dir}/${params.megflow.report_scope == 'corpus' ? 'corpus_static_html_report' : 'static_html_report'}/nextflow/trace.txt"
    overwrite = true
}

workflow {
    failOnIgnore = false
}

// Nextflow already runs inside the MEGFlow image. Enabling this scope would
// create unsupported nested Docker tasks. Output ownership is handled by the
// image entrypoint before it starts Nextflow.
docker {
    enabled = false
}

// Lazy strings keep later additive overlays visible while resolving "auto" to
// the same container-aware values used by Nextflow's local executor defaults.
executor {
    $local {
        cpus = "${-> params.megflow.execution.local_cpus == 'auto' ? Runtime.runtime.availableProcessors() : params.megflow.execution.local_cpus}"
        memory = "${-> params.megflow.execution.local_memory == 'auto' ? java.lang.management.ManagementFactory.operatingSystemMXBean.totalPhysicalMemorySize : params.megflow.execution.local_memory}"
        queueSize = "${-> params.megflow.execution.local_max_tasks == 'auto' ? Runtime.runtime.availableProcessors() : params.megflow.execution.local_max_tasks}"
    }
}

process {
    executor = "local"
    cpus = 2
    memory = "8 GB"
    beforeScript = { "export NUMEXPR_MAX_THREADS=${task.cpus} OMP_NUM_THREADS=${task.cpus} MKL_NUM_THREADS=${task.cpus} OPENBLAS_NUM_THREADS=${task.cpus}" }
    errorStrategy = { params.megflow.error_mode == "strict" ? "terminate" : (task.exitStatus in 137..140 ? "retry" : "ignore") }
    maxRetries = 2

    withName: 'import_mri_dataset|import_meg_dataset' {
        cpus = 1
        memory = "2 GB"
        errorStrategy = "terminate"
        maxRetries = 0
    }

    withName: dcm2niix {
        cpus = 2
        memory = "4 GB"
    }

    withName: generate_pseudomri {
        cpus = 2
        memory = "8 GB"
        maxRetries = 3
    }

    withName: run_freesurfer {
        cpus = 4
        memory = { 24.GB * task.attempt }
        time = "72h"
        maxRetries = 2
    }

    withName: run_deepprep {
        cpus = 4
        memory = { 32.GB * task.attempt }
        time = "72h"
        maxRetries = 2
    }

    withName: 'run_mkheadsurf|generate_bem' {
        cpus = 2
        memory = "8 GB"
        maxRetries = 2
    }

    withName: score_meg_quality {
        cpus = 4
        memory = { 4.GB * task.attempt }
        beforeScript = "export NUMEXPR_MAX_THREADS=1 OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1"
        maxRetries = 3
    }

    withName: meg_basic_preproc {
        cpus = 4
        memory = { 6.GB * task.attempt }
        maxRetries = 3
    }

    withName: detect_artifacts {
        cpus = 4
        memory = { 12.GB * task.attempt }
        beforeScript = "export NUMEXPR_MAX_THREADS=1 OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1"
        maxRetries = 3
    }

    withName: run_ica {
        cpus = 4
        memory = { 8.GB * task.attempt }
        maxRetries = 3
    }

    withName: run_ic_label {
        cpus = 4
        memory = { 8.GB * task.attempt }
        maxRetries = 3
    }

    withName: 'apply_ica|epochs' {
        cpus = 2
        memory = "8 GB"
        maxRetries = 3
    }

    withName: 'generate_static_html_report|generate_corpus_static_html_report' {
        cpus = 2
        memory = "8 GB"
        errorStrategy = "terminate"
        maxRetries = 0
    }

    withName: coregistration {
        cpus = 4
        memory = "8 GB"
        time = "2h"
        errorStrategy = { params.megflow.error_mode == "strict" ? "terminate" : ((task.exitStatus in 134..140 || task.exitStatus == 1) && task.attempt <= 6 ? "retry" : "ignore") }
        maxRetries = 6
    }

    withName: compute_covariance {
        cpus = 2
        memory = "8 GB"
        errorStrategy = { params.megflow.error_mode == "strict" || task.exitStatus == 2 ? "terminate" : (task.exitStatus in 137..140 || task.exitStatus == 1 ? "retry" : "ignore") }
        maxRetries = 3
    }

    withName: forward_solution {
        cpus = 2
        memory = "8 GB"
        maxRetries = 3
    }

    withName: source_imaging {
        cpus = 4
        memory = { 8.GB * task.attempt }
        time = "6h"
        errorStrategy = { params.megflow.error_mode == "strict" || task.exitStatus == 2 ? "terminate" : (task.exitStatus in 137..140 || task.exitStatus == 1 ? "retry" : "ignore") }
        maxRetries = 6
    }
}

profiles {
    local {
        process.executor = "local"
    }

    lenient {
        params {
            megflow {
                error_mode = "lenient"
            }
        }
        workflow {
            failOnIgnore = false
        }
    }

    strict {
        params {
            megflow {
                error_mode = "strict"
            }
        }
        workflow {
            failOnIgnore = true
        }
    }

    debug {
        log.level = "DEBUG"
        process.maxForks = 1
    }
}
