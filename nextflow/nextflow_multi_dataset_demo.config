// Runnable source-mode example with dataset-specific settings for WAND,
// SMN4Lang, and MEG-MASC. Edit dataset/output/anatomy paths and subject filters,
// then run:
//   bash run_MultiDatasets_sourcecode.sh
//
// Docker corpus mode uses container-visible roots and profiles named after each
// immediate /input child; see docs/source/reference/examples.rst.
includeConfig "nextflow.config"

params {
    megflow = [
        code_dir: "/data/liaopan/megprep/megflow",
        output_dir: "/data/liaopan/datasets/megflow_multi_dataset_demo_3datasets_source_smn4lang",
        report_scope: "corpus",
        corpus_root: "",
        dataset_include: [],
        dataset_exclude: ["SMN4Lang_single2"],
        error_mode: "strict",

        defaults: [
            steps: "meg_epochs",
            dataset_format: "auto",
            file_suffix: ".fif",
            is_bids: true,
            visualize: true,
            // Shared default for covariance and source; explicit function rank keys override it.
            rank_policy: "auto",

            seeds: [
                osl: 2025,
                ica: 2025
            ],

            anatomy: [
                method: "freesurfer",
                is_bids: true,
                select_tag: "",
                t1_input_type: "nifti",
                t1_dicom_series_glob: "",
                deepprep_backend: "auto",
                deepprep_command: "/opt/DeepPrep/deepprep/deepprep.sh",
                deepprep_container: "cmrlab/megflow:1.0.0",
                deepprep_sif: "",
                fs_license_file: "/fs_license.txt",
                pseudomri_template_dir: "/data/liaopan/megprep/megflow/tools/pseudomri",
                pseudomri_template_subject: "mni_icbm152_nlin_sym_09a",
                deepprep_device: "cpu"
            ],

            mri_import: [
                subject_id: null,
                session_id: null,
                task: null,
                run_id: null
            ],

            meg_import: [
                subject_id: "first:10",
                session_id: null,
                task: null,
                run_id: null,
                raw_include_keywords: null,
                raw_exclude_keywords: null
            ],

            megqc: [
                enabled: true,
                min_score: 0.0,
                alarm_score: 60.0,
                meg_vendor: "auto",
                category: "auto",
                reference_scope: "device_category",
                min_reference_n: 20,
                freq_max_samples: 0,
                dfa_max_samples: 20000,
                dfa_method: "msqms",
                skip_dfa: false,
                keep_bad_annotations: true,
                omit_bad_channels: false,
                seg_length: 100,
                preproc: [
                    [filter: [l_freq: 1.0, h_freq: 100.0, method: "iir", iir_params: [order: 5, ftype: "butter"]]],
                    [notch_filter: [freqs: 50]]
                ]
            ],

            preproc: [
                steps: [
                    [filter: [l_freq: 1.0, h_freq: 100.0, method: "iir", iir_params: [order: 5, ftype: "butter"]]],
                    [notch_filter: [freqs: "50 100"]],
                    [resample: [sfreq: 250]]
                ]
            ],

            digitization: [
                enabled: true,
                coordsystem_file_pattern: "{prefix}_coordsystem.json",
                hsp_file_pattern: "{prefix}_headshape.pos",
                elp_file_pattern: null
            ],

            artifacts: [
                deepreject: [
                    enabled: true,
                    mode: "default",
                    device: "cpu",
                    category: "auto",
                    pick_meg_only: true,
                    pick_exclude_marked_bads: false,
                    keep_meg_only_input: false,
                    run_bad_segments: true,
                    run_bad_channels: true,
                    on_error: "warn",
                    fold_workers: 5,
                    cache_models: true,
                    cpu_threads: 4,
                    cpu_interop_threads: 1,
                    badsegnet_batch_size: 32
                ],
                find_bad_channels: [
                    pyprep: [
                        deviation: [deviation_threshold: 5.0],
                        snr: [:],
                        nan_flat: [:]
                    ],
                    psd: [std_multiplier: 6],
                    osl: [ref_meg: "auto", significance_level: 0.05],
                    mne: [
                        find_bad_channels_lof: [
                            n_neighbors: 20,
                            picks: "mag",
                            metric: "euclidean",
                            threshold: 1.5
                        ]
                    ]
                ],
                find_bad_segments: [
                    keep_existing_annotations: false,
                    osl: [segment_len: 1000]
                ],
                interpolate_bads: false,
                artifact_images_enabled: false,
                artifact_image_n_jobs: 8,
                meg_vendor: "auto"
            ],

            ica: [
                output_dir: "ica_report",
                num_components: 60,
                compute_explained_variance: false
            ],

            ic_label: [
                ic_ecg: false,
                ic_eog: false,
                ic_outlier: false,
                ica_label: true,
                mne_algorithm: false,
                rules_algorithm: false,
                ICA_classify: [
                    meg_vendor: "auto",
                    explained_var: [
                        threshold: 0.1,
                        ch_type: "mag"
                    ]
                ]
            ],

            epochs: [
                output_dir: "epochs",
                preproc: [],
                task_type: "task",
                resting: [
                    fixed_length_duration: 2.0
                ],
                event_source: "event_file",
                event_time_shift_sec: 0.0,
                autoreject: false,
                interpolate_bads: false,
                drop_bad_channels: false,
                event_file: [
                    trial_type: null
                ],
                find_events: [
                    stim_channel: null,
                    shortest_event: 1,
                    min_duration: 0.0
                ],
                epochs: [
                    event_id: 1,
                    tmin: -0.2,
                    tmax: 0.8,
                    reject_by_annotation: true,
                    picks: "meg",
                    baseline: [null, 0.0],
                    reject: [mag: 4e-12],
                    preload: true,
                    detrend: null
                ]
            ],

            bem: [
                ico: 4,
                conductivity: [0.3]
            ],

            coreg: [
                output_dir: "trans",
                visualize: true,
                omit_head_shape_points: 1,
                grow_hair: 0.0,
                icp: [
                    n_iterations: 200,
                    lpa_weight: 1.0,
                    nasion_weight: 10.0,
                    rpa_weight: 1.0,
                    hsp_weight: 10.0,
                    eeg_weight: 0.0,
                    hpi_weight: 1.0
                ],
                finetune_icp: [
                    n_iterations: 200,
                    lpa_weight: 0.0,
                    nasion_weight: 0.0,
                    rpa_weight: 0.0,
                    hsp_weight: 10.0,
                    eeg_weight: 0.0,
                    hpi_weight: 0.0
                ]
            ],

            covariance: [
                output_dir: "covariance",
                visualize: true,
                type: "epochs",
                raw_covariance_task_id: "emptr",
                event_time_shift_sec: 0.0,
                compute_raw_covariance: [
                    tmin: 0,
                    tmax: null,
                    method: "auto",
                    reject: [mag: 4e-12],
                    reject_by_annotation: true
                ],
                events: [
                    stim_channel: null,
                    shortest_event: 1,
                    min_duration: 0.0
                ],
                epochs: [
                    event_id: 1,
                    tmin: -0.2,
                    tmax: 0.0,
                    picks: "mag",
                    baseline: null,
                    preload: true,
                    detrend: null,
                    reject_by_annotation: true
                ],
                covariance: [
                    tmin: null,
                    tmax: null
                ]
            ],

            forward: [
                output_dir: "forward_solution",
                epoch_label: "wdonset",
                surface: "white",
                spacing: "ico4"
            ],

            source: [
                output_dir: "source_recon",
                type: "epochs",
                visualize: false,
                source_methods: ["dSPM"],
                data_type: "meg",
                spacing: "ico4",
                epoch_label: "wdonset",
                dSPM: [
                    inverse_operator: [
                        loose: "auto",
                        depth: 0.8,
                        fixed: "auto"
                    ],
                    apply_inverse: [
                        method: "dSPM",
                        pick_ori: "normal"
                    ]
                ],
                LCMV: [
                    data_covariance: [
                        tmin: 0.01,
                        tmax: 0.4,
                        method: "auto"
                    ],
                    make_lcmv: [
                        reg: 0.05,
                        pick_ori: null,
                        weight_norm: "unit-noise-gain-invariant"
                    ]
                ]
            ],

            report: [
                bad_channel_threshold: 30,
                bad_segment_threshold: 50,
                coreg_mean_threshold: 5.0,
                coreg_max_threshold: 20.0,
                epoch_reject_rate_threshold: 0.90,
                static_artifact_overview_duration: 200.0,
                alert_missing_ecg_components: false,
                alert_missing_eog_components: false,
                static_task_log_mode: "all-command-log"
            ]
        ],

        datasets: [
            WAND_visual: [
                dataset_dir: "/data/liaopan/datasets/WAND_Extracted",
                fs_subjects_dir: "/data/liaopan/datasets/WAND_Extracted/smri",
                steps: "meg_epochs",
                meg_import: [
                    subject_id: "first:10",
                    session_id: ["01"],
                    task: ["visual"],
                    run_id: null
                ],
                mri_import: [
                    subject_id: "first:10"
                ],
                megqc: [
                    meg_vendor: "ctf"
                ],
                artifacts: [
                    meg_vendor: "ctf"
                ],
                ic_label: [
                    ICA_classify: [
                        meg_vendor: "ctf"
                    ]
                ],
                epochs: [
                    preproc: [
                        [filter: [l_freq: 1.0, h_freq: 40.0, method: "iir", iir_params: [order: 5, ftype: "butter"]]]
                    ],
                    event_source: "find_events",
                    event_time_shift_sec: 0.0,
                    find_events: [
                        stim_channel: "UPPT001",
                        shortest_event: 1,
                        min_duration: 0.0
                    ],
                    epochs: [
                        event_id: 1,
                        tmin: -0.2,
                        tmax: 1.0,
                        baseline: [null, 0.0]
                    ]
                ],
                covariance: [
                    event_time_shift_sec: 0.0,
                    events: [
                        stim_channel: "UPPT001",
                        shortest_event: 1,
                        min_duration: 0.0
                    ],
                    epochs: [
                        event_id: 1,
                        tmin: -0.2,
                        tmax: 0.0,
                        baseline: [null, 0.0]
                    ]
                ],
                source: [
                    epoch_label: "visual_onset",
                    visualize: true
                ],
                forward: [
                    epoch_label: "visual_onset"
                ]
            ],

            SMN4Lang_RDR: [
                dataset_dir: "/data/liaopan/datasets/SMN4Lang",
                fs_subjects_dir: "/data/liaopan/datasets/SMN4Lang_smri",
                steps: "meg_all",
                rank_policy: [meg: 50],
                meg_import: [
                    subject_id: "first:10",
                    task: ["RDR"],
                    run_id: ["1"]
                ],
                mri_import: [
                    subject_id: "first:10"
                ],
                megqc: [
                    meg_vendor: "elekta"
                ],
                artifacts: [
                    meg_vendor: "elekta"
                ],
                ic_label: [
                    ICA_classify: [
                        meg_vendor: "elekta"
                    ]
                ],
                epochs: [
                    preproc: [
                        [filter: [l_freq: 1.0, h_freq: 45.0, method: "iir", iir_params: [order: 5, ftype: "butter"]]]
                    ],
                    event_source: "event_file",
                    event_time_shift_sec: -10.6105,
                    event_file: [
                        trial_type: [
                            char: 1
                        ]
                    ],
                    epochs: [
                        event_id: 1,
                        tmin: -0.2,
                        tmax: 0.5,
                        baseline: [null, 0.0]
                    ]
                ],
                covariance: [
                    event_source: "event_file",
                    event_time_shift_sec: -10.6105,
                    event_file: [
                        trial_type: [
                            char: 1
                        ]
                    ],
                    epochs: [
                        event_id: null,
                        tmin: -0.2,
                        tmax: 0.0,
                        baseline: [null, 0.0]
                    ]
                ],
                source: [
                    epoch_label: "char_onset",
                    visualize: true,
                    source_methods: ["dSPM"],
                    data_type: "meg",
                    spacing: "ico4",
                    dSPM: [
                        inverse_operator: [
                            loose: "auto",
                            depth: 0.8,
                            fixed: "auto"
                        ],
                        apply_inverse: [
                            method: "dSPM",
                            pick_ori: "normal"
                        ]
                    ]
                ],
                forward: [
                    epoch_label: "char_onset"
                ]
            ],

            MEG_MASC_word: [
                dataset_dir: "/data/liaopan/datasets/MEG-MASC",
                fs_subjects_dir: "/data/liaopan/datasets/MEG-MASC/smri",
                steps: "meg_epochs",
                dataset_format: "bids",
                file_suffix: ".con",
                meg_import: [
                    subject_id: ["05", "09", "11", "14", "23"],
                    session_id: ["0"],
                    task: ["0"],
                    run_id: null
                ],
                megqc: [
                    meg_vendor: "kit"
                ],
                digitization: [
                    coordsystem_file_pattern: "{prefix}_coordsystem.json",
                    hsp_file_pattern: "{prefix}_acq-HSP_headshape.pos",
                    elp_file_pattern: "{prefix}_acq-ELP_headshape.pos"
                ],
                coreg: [
                    finetune_icp: [
                        n_iterations: 200,
                        lpa_weight: 1.0,
                        nasion_weight: 10.0,
                        rpa_weight: 1.0,
                        hsp_weight: 10.0,
                        eeg_weight: 0.0,
                        hpi_weight: 1.0
                    ]
                ],
                artifacts: [
                    meg_vendor: "kit",
                    deepreject: [
                        mode: "lenient"
                    ]
                ],
                ic_label: [
                    ICA_classify: [
                        meg_vendor: "kit"
                    ]
                ],
                epochs: [
                    preproc: [
                        [filter: [l_freq: 1.0, h_freq: 30.0, method: "iir", iir_params: [order: 5, ftype: "butter"]]]
                    ],
                    event_source: "event_file",
                    event_time_shift_sec: 0.0,
                    event_file: [
                        trial_type_fields: [
                            kind: "word"
                        ],
                        event_id: 1
                    ],
                    epochs: [
                        event_id: 1,
                        tmin: -0.2,
                        tmax: 0.6,
                        baseline: [null, 0.0],
                        reject: null
                    ]
                ],
                covariance: [
                    event_source: "event_file",
                    event_time_shift_sec: 0.0,
                    event_file: [
                        trial_type_fields: [
                            kind: "word"
                        ],
                        event_id: 1
                    ],
                    epochs: [
                        event_id: 1,
                        tmin: -0.2,
                        tmax: 0.0,
                        baseline: [null, 0.0],
                        reject: null
                    ]
                ],
                source: [
                    epoch_label: "word_onset",
                    visualize: true
                ],
                forward: [
                    epoch_label: "word_onset"
                ]
            ]
        ]
    ]
}

workDir = "${params.megflow.output_dir}/work"
log.file = "${params.megflow.output_dir}/corpus_static_html_report/nextflow/nextflow.log"
report.file = "${params.megflow.output_dir}/corpus_static_html_report/nextflow/report.html"
timeline.file = "${params.megflow.output_dir}/corpus_static_html_report/nextflow/timeline.html"
trace.file = "${params.megflow.output_dir}/corpus_static_html_report/nextflow/trace.txt"

process {
    beforeScript = "export NUMEXPR_MAX_THREADS=8 OMP_NUM_THREADS=8 MKL_NUM_THREADS=8 OPENBLAS_NUM_THREADS=8"

    withName: import_meg_dataset {
        maxForks = 1
    }

    withName: score_meg_quality {
        maxForks = 6
    }

    withName: meg_basic_preproc {
        maxForks = 6
    }

    withName: detect_artifacts {
        maxForks = 4
    }

    withName: run_ica {
        maxForks = 4
    }

    withName: run_ic_label {
        maxForks = 6
    }

    withName: apply_ica {
        maxForks = 6
    }

    withName: coregistration {
        maxForks = 6
    }

    withName: compute_covariance {
        maxForks = 6
    }

    withName: source_imaging {
        maxForks = 6
    }
}
