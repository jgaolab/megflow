// Source-run overlay for the SMN4Lang pseudo-MRI smoke/full test.
includeConfig "nextflow.config"

params.megflow.output_dir = "/data/liaopan/datasets/SMN4Lang_single2/pseudomri_full_source"
params.megflow.dataset_include = ["SMN4Lang_single2"]
params.megflow.report_scope = "dataset"

params.megflow.datasets.SMN4Lang_single2.output_dir = params.megflow.output_dir
params.megflow.datasets.SMN4Lang_single2.preproc_dir = "${params.megflow.output_dir}/preprocessed"
params.megflow.datasets.SMN4Lang_single2.fs_subjects_dir = "${params.megflow.output_dir}/smri"
params.megflow.datasets.SMN4Lang_single2.steps = "all"
params.megflow.datasets.SMN4Lang_single2.anatomy = [
    method: "pseudomri"
]

workDir = "${params.megflow.output_dir}/work"
log.file = "${params.megflow.output_dir}/static_html_report/nextflow/nextflow.log"
report.file = "${params.megflow.output_dir}/static_html_report/nextflow/report.html"
timeline.file = "${params.megflow.output_dir}/static_html_report/nextflow/timeline.html"
trace.file = "${params.megflow.output_dir}/static_html_report/nextflow/trace.txt"
