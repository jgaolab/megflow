// Three-level MEGFlow configuration example for OPM-COG:
//   1. defaults: policy shared by every dataset
//   2. datasets.OPM_COG: settings shared by this dataset
//   3. recordings: task-specific epoch, covariance, forward, and source settings
//
// Edit the paths and selectors, then run:
//   nextflow -log /data/liaopan/datasets/OPM-COG.v1/derivatives/megflow-three-level/static_html_report/nextflow/nextflow.log \
//     -C nextflow/nextflow_opm_cog_task_overrides_example.config \
//     run nextflow/megflow.nf -profile local,strict -resume

includeConfig "nextflow.config"

params {
    megflow {
        code_dir = "/data/liaopan/megprep/megflow"
        output_dir = "/data/liaopan/datasets/OPM-COG.v1/derivatives/megflow-three-level"
        report_scope = "dataset"
        corpus_root = ""
        dataset_include = []
        dataset_exclude = []
        error_mode = "strict"

        // Level 1: change only the shared fields needed by this example. Every
        // other processing parameter remains inherited from nextflow.config.
        defaults {
            steps = "meg_all"
            dataset_format = "bids"
            file_suffix = ".fif"
            meg_import {
                subject_id = "first:10"
                session_id = null
                task = null
                run_id = null
            }
            epochs {
                event_source = "event_file"
                event_time_shift_sec = 0.0
                epochs = [
                    event_id: 1,
                    tmin: -0.2,
                    tmax: 0.8,
                    baseline: [null, 0.0]
                ]
            }
            covariance {
                type = "epochs"
                event_time_shift_sec = 0.0
                epochs {
                    event_id = 1
                    tmin = -0.2
                    tmax = 0.0
                }
            }
            forward {
                epoch_label = "event_onset"
                spacing = "ico4"
            }
            source {
                type = "epochs"
                source_methods = ["dSPM"]
                data_type = "meg"
                spacing = "ico4"
                epoch_label = "event_onset"
                visualize = false
            }
        }

        datasets {
            // Level 2: settings common to every OPM-COG recording.
            OPM_COG {
                dataset_dir = "/data/liaopan/datasets/OPM-COG.v1"
                fs_subjects_dir = "/data/liaopan/datasets/OPM-COG.v1/smri"
                t1_dir = "/data/liaopan/datasets/OPM-COG.v1"
                steps = "meg_all"

                // Discovery happens before recording matching, so every task that
                // needs a recording override must be imported here.
                meg_import {
                    subject_id = ["01"]
                    session_id = ["opm"]
                    task = ["aef", "vef", "tap", "ssvef"]
                    run_id = ["01"]
                }
                mri_import {
                    subject_id = ["01"]
                    session_id = ["opm"]
                }
                megqc {
                    meg_vendor = "opm"
                }
                artifacts {
                    meg_vendor = "opm"
                    deepreject {
                        enabled = false
                    }
                }
                ic_label {
                    ICA_classify {
                        meg_vendor = "opm"
                    }
                }
                epochs {
                    event_file {
                        trial_type = ["Stimulus onset"]
                        event_id = 1
                    }
                    epochs = [
                        reject_by_annotation: false,
                        reject: null
                    ]
                }
                covariance {
                    event_source = "event_file"
                    event_file {
                        trial_type = ["Stimulus onset"]
                        event_id = 1
                    }
                    epochs {
                        reject_by_annotation = false
                        baseline = [null, 0.0]
                        reject = null
                    }
                }
                source {
                    visualize = true
                }

                // Level 3: task-specific overrides. Each block deep-merges into
                // the effective defaults + OPM_COG dataset configuration.
                recordings {
                    auditory_evoked {
                        match {
                            task = "aef"
                        }
                        epochs {
                            event_time_shift_sec = 0.04858
                            epochs = [
                                tmin: -0.1,
                                tmax: 0.5
                            ]
                        }
                        covariance {
                            event_time_shift_sec = 0.04858
                            epochs {
                                tmin = -0.1
                                tmax = 0.0
                            }
                        }
                        forward {
                            epoch_label = "aef_onset"
                        }
                        source {
                            epoch_label = "aef_onset"
                            visualization {
                                name = "auditory_230ms"
                                mode = "label"
                                roi = "auditory"
                                time = 0.230
                                hemi = "both"
                            }
                        }
                    }

                    visual_evoked {
                        match {
                            task = "vef"
                        }
                        epochs {
                            event_time_shift_sec = 0.04488
                            epochs = [
                                tmin: -0.2,
                                tmax: 0.6
                            ]
                        }
                        covariance {
                            event_time_shift_sec = 0.04488
                            epochs {
                                tmin = -0.2
                                tmax = 0.0
                            }
                        }
                        forward {
                            epoch_label = "vef_onset"
                        }
                        source {
                            epoch_label = "vef_onset"
                            visualization {
                                name = "visual_110ms"
                                mode = "label"
                                roi = "occipital"
                                time = 0.110
                                hemi = "both"
                            }
                        }
                    }

                    finger_tapping {
                        match {
                            task = "tap"
                        }
                        epochs {
                            epochs = [
                                tmin: -0.3,
                                tmax: 0.8
                            ]
                        }
                        covariance {
                            epochs {
                                tmin = -0.3
                                tmax = 0.0
                            }
                        }
                        forward {
                            epoch_label = "tap_onset"
                        }
                        source {
                            epoch_label = "tap_onset"
                            visualization {
                                name = "motor_100ms"
                                mode = "label"
                                roi = "motor"
                                time = 0.100
                                hemi = "both"
                            }
                        }
                    }

                    steady_state_visual {
                        match {
                            task = "ssvef"
                        }
                        epochs {
                            epochs = [
                                tmin: -0.5,
                                tmax: 2.0
                            ]
                        }
                        covariance {
                            epochs {
                                tmin = -0.5
                                tmax = 0.0
                            }
                        }
                        forward {
                            epoch_label = "ssvef_onset"
                        }
                        source {
                            epoch_label = "ssvef_onset"
                            visualization {
                                name = "ssvef_occipital_peak"
                                mode = "label"
                                roi = "occipital"
                                hemi = "both"
                            }
                        }
                    }
                }
            }
        }
    }
}

workDir = "${params.megflow.output_dir}/work"
log.file = "${params.megflow.output_dir}/static_html_report/nextflow/nextflow.log"
report.file = "${params.megflow.output_dir}/static_html_report/nextflow/report.html"
timeline.file = "${params.megflow.output_dir}/static_html_report/nextflow/timeline.html"
trace.file = "${params.megflow.output_dir}/static_html_report/nextflow/trace.txt"
