// Maxwell/tSSS preprocessing example for MEGIN/Elekta recordings.
//
// This file demonstrates all three MEGFlow configuration levels:
//   1. defaults: a generic Maxwell/tSSS policy
//   2. dataset: site-specific calibration and cross-talk files
//   3. recording: a task-specific tSSS window override
//
// Edit every placeholder path and selector before running. Maxwell/tSSS is not
// enabled in the shipped defaults because it is device- and site-specific.
//
// Run:
//   nextflow -C nextflow/nextflow_maxwell_tsss_example.config \
//     run nextflow/megflow.nf -profile local,strict -resume

includeConfig "nextflow.config"

params {
    megflow {
        // Run-level paths and execution policy.
        code_dir = "/data/liaopan/megprep/megflow"
        output_dir = "/data/site-a/derivatives/megflow-tsss"
        report_scope = "dataset"
        corpus_root = ""
        dataset_include = []
        dataset_exclude = []
        error_mode = "strict"

        // Level 1: generic policy shared by all datasets in this run.
        defaults {
            steps = "meg_ica"
            dataset_format = "bids"
            file_suffix = ".fif"
            preproc {
                steps = [
                    [maxwell_filter: [
                        origin: "auto",
                        int_order: 8,
                        ext_order: 3,
                        calibration: null,
                        cross_talk: null,
                        st_duration: 10.0,
                        st_correlation: 0.98,
                        coord_frame: "head",
                        destination: null,
                        regularize: "in",
                        bad_condition: "warning",
                        st_fixed: true,
                        st_only: false,
                        skip_by_annotation: ["edge", "bad_acq_skip"]
                    ]],
                    [filter: [
                        l_freq: 1.0,
                        h_freq: 100.0,
                        method: "iir",
                        iir_params: [order: 5, ftype: "butter"]
                    ]],
                    [notch_filter: [freqs: [50, 100]]],
                    [resample: [sfreq: 250]]
                ]
            }
        }

        datasets {
            // Level 2: calibration and cross-talk files are specific to this system.
            MEGIN_SITE_A {
                dataset_dir = "/data/site-a/bids"
                fs_subjects_dir = "/data/site-a/smri"
                t1_dir = "/data/site-a/bids"
                meg_import {
                    subject_id = "first:10"
                    session_id = null
                    task = ["rest", "movement"]
                    run_id = null
                }
                preproc {
                    steps = [
                        [maxwell_filter: [
                            origin: "auto",
                            int_order: 8,
                            ext_order: 3,
                            calibration: "/data/site-a/calibration/sss_cal.dat",
                            cross_talk: "/data/site-a/calibration/ct_sparse.fif",
                            st_duration: 10.0,
                            st_correlation: 0.98,
                            coord_frame: "head",
                            destination: null,
                            regularize: "in",
                            bad_condition: "warning",
                            st_fixed: true,
                            st_only: false,
                            skip_by_annotation: ["edge", "bad_acq_skip"]
                        ]],
                        [filter: [
                            l_freq: 1.0,
                            h_freq: 100.0,
                            method: "iir",
                            iir_params: [order: 5, ftype: "butter"]
                        ]],
                        [notch_filter: [freqs: [50, 100]]],
                        [resample: [sfreq: 250]]
                    ]
                }

                recordings {
                    // Level 3: lists replace inherited lists, so this recording gives
                    // the complete ordered chain with its longer tSSS window.
                    movement_long_tsss_window {
                        match = [task: "movement"]
                        preproc {
                            steps = [
                                [maxwell_filter: [
                                    origin: "auto",
                                    int_order: 8,
                                    ext_order: 3,
                                    calibration: "/data/site-a/calibration/sss_cal.dat",
                                    cross_talk: "/data/site-a/calibration/ct_sparse.fif",
                                    st_duration: 20.0,
                                    st_correlation: 0.96,
                                    coord_frame: "head",
                                    destination: null,
                                    regularize: "in",
                                    bad_condition: "warning",
                                    st_fixed: true,
                                    st_only: false,
                                    skip_by_annotation: ["edge", "bad_acq_skip"]
                                ]],
                                [filter: [
                                    l_freq: 1.0,
                                    h_freq: 100.0,
                                    method: "iir",
                                    iir_params: [order: 5, ftype: "butter"]
                                ]],
                                [notch_filter: [freqs: [50, 100]]],
                                [resample: [sfreq: 250]]
                            ]
                        }
                    }
                }
            }
        }
    }
}

workDir = "${params.megflow.output_dir}/work"
log.file = "${params.megflow.output_dir}/static_html_report/nextflow/nextflow.log"
report.file = "${params.megflow.output_dir}/static_html_report/nextflow/report.html"
timeline.file = "${params.megflow.output_dir}/static_html_report/nextflow/timeline.html"
trace.file = "${params.megflow.output_dir}/static_html_report/nextflow/trace.txt"
