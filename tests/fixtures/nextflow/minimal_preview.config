params {
    megflow = [
        code_dir: "${projectDir}/../megflow",
        output_dir: "/tmp/megflow-preview-output",
        corpus_root: "",
        dataset_include: [],
        dataset_exclude: [],
        error_mode: "strict",
        defaults: [
            steps: "report",
            megqc: [enabled: false]
        ],
        datasets: [
            preview: [
                dataset_dir: "${projectDir}/../tests/fixtures/data/dataset-a"
            ]
        ]
    ]
}

workDir = "/tmp/megflow-preview-work"
log.file = "/tmp/megflow-preview-output/nextflow.log"
report.enabled = false
timeline.enabled = false
trace.enabled = false
process.executor = "local"
