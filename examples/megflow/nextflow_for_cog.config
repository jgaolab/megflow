// Docker-oriented v2 overlay for a task MEG run.
// Mount this file under /config and pass it with --config. The entrypoint loads
// the complete image base config before applying this overlay with Nextflow -c.

params.megflow.datasets.docker_input.meg_import = [
    subject_id: ["04"],
    session_id: null,
    task: ["aef"],
    run_id: null,
    raw_include_keywords: null,
    raw_exclude_keywords: null
]

params.megflow.datasets.docker_input.preproc = [
    steps: [
        [filter: [l_freq: 1.0, h_freq: 40.0, method: "iir",
                  iir_params: [order: 5, ftype: "butter"]]],
        [notch_filter: [freqs: "50 100"]],
        [resample: [sfreq: 250]]
    ]
]

params.megflow.datasets.docker_input.epochs = [
    task_type: "task",
    event_source: "find_events",
    event_time_shift_sec: 0.0,
    find_events: [
        stim_channel: null,
        shortest_event: 1,
        min_duration: 0.0
    ],
    epochs: [
        event_id: null,
        tmin: -0.2,
        tmax: 0.8,
        reject_by_annotation: true,
        picks: "meg",
        baseline: [null, 0.0],
        reject: [mag: 4e-12],
        preload: true,
        detrend: null
    ]
]

params.megflow.datasets.docker_input.covariance = [
    type: "epochs",
    event_time_shift_sec: 0.0,
    epochs: [
        event_id: null,
        tmin: -0.2,
        tmax: 0.0,
        picks: "mag",
        baseline: null,
        reject_by_annotation: true
    ]
]

// Select the stage at launch, for example --steps meg_ica for a first pass or
// --steps meg_all after events, covariance, and anatomy have been verified.
