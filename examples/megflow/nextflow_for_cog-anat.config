// Docker-oriented v2 overlay for structural MRI processing only.
// Mount this file under /config, pass it with --config, and launch with
// --steps anatomy. Mount and pass a valid FreeSurfer license as well. The
// entrypoint loads the complete image base config before this overlay.

params.megflow.datasets.docker_input.mri_import = [
    subject_id: ["01"],
    session_id: null,
    task: null,
    run_id: null
]

params.megflow.datasets.docker_input.anatomy = [
    method: "freesurfer",
    is_bids: true,
    select_tag: "",
    t1_input_type: "nifti",
    t1_dicom_series_glob: ""
]

// For DeepPrep BIDS anatomy, change method to "deepprep" and optionally set
// deepprep_device to "cpu" or "gpu". For non-BIDS NIfTI/DICOM, keep
// method="freesurfer", set is_bids=false, and configure t1_input_type.
