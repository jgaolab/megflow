// MEGFlow v2 Docker project overlay migrated from nextflow_for_cog.config.
//
// Mount this file at /config/nextflow_for_cog.config and pass it with
// --config /config/nextflow_for_cog.config. Keep the image base configuration
// at /program/nextflow/nextflow.config.
includeConfig "/program/nextflow/nextflow.config"

params.megflow.error_mode = "lenient"

// Level 1: defaults shared by all datasets and recordings in this run.
// Unlisted settings continue to come from the image base configuration.
params.megflow.defaults.steps = "meg_all"
params.megflow.defaults.visualize = true
params.megflow.defaults.rank_policy = "auto"

params.megflow.defaults.seeds = [
    osl: 2025,
    ica: 2025
]

// Preserve the original COG continuous preprocessing exactly.
params.megflow.defaults.preproc = [
    steps: [
        [filter: [
            l_freq: 0.5,
            h_freq: 40,
            method: "iir",
            iir_params: [order: 5, ftype: "butter"]
        ]],
        [notch_filter: [freqs: "50 100"]],
        [resample: [sfreq: 100]]
    ]
]

params.megflow.defaults.ica = [
    num_components: 60,
    compute_explained_variance: false
]

params.megflow.defaults.ic_label = [
    ic_ecg: true,
    ic_eog: true,
    ic_outlier: false,
    mne_icalabel: true,
    megnet_retrained: false,
    mne_algorithm: true,
    rules_algorithm: true,

    find_bads_eog: [
        ch_name: null,
        threshold: "auto",
        l_freq: 1,
        h_freq: 10,
        start: null,
        stop: null,
        measure: "zscore"
    ],

    find_bads_ecg: [
        ch_name: null,
        threshold: "auto",
        method: "ctps",
        l_freq: 8,
        h_freq: 16,
        measure: "zscore"
    ],

    find_bads_muscle: [
        threshold: 0.5,
        start: null,
        stop: null,
        l_freq: 7,
        h_freq: 45
    ],

    ICA_classify: [
        meg_vendor: "auto",
        explained_var: [
            threshold: 0.1,
            ch_type: "mag"
        ],
        find_ecg_ics: [
            time_segment: 10,
            ts_ecg_num_max: 20,
            l_freq: 0.1,
            h_freq: 10,
            peak_threshod_coef: 0.4,
            peak_std_threshold_coef: 0.05
        ],
        find_abnormal_psd_ics: [
            attention_low_freq: 0,
            attention_high_freq: 150,
            le_low_freq: 0,
            le_high_freq: 12,
            low_freq_energy_threshold: 0.8
        ]
    ]
]

// These report controls are configuration-only in the current Docker CLI.
params.megflow.defaults.report.static_task_log_mode = "all-command-log"
params.megflow.defaults.report.static_artifact_overview_duration = 200.0

// Level 2: settings shared by the COG dataset.
params.megflow.datasets = [
    docker_input: [
        name: "COG",
        dataset_dir: "/input",
        output_dir: "/output",
        preproc_dir: "/output/preprocessed",
        fs_subjects_dir: "/smri",
        t1_dir: "/input",
        dataset_format: "auto",
        file_suffix: ".fif",
        is_bids: true,

        anatomy: [
            method: "freesurfer",
            is_bids: true,
            select_tag: "",
            t1_input_type: "nifti",
            t1_dicom_series_glob: "",
            deepprep_device: "cpu"
        ],

        mri_import: [
            subject_id: ["04"],
            session_id: null,
            task: null,
            run_id: null
        ],

        meg_import: [
            subject_id: ["04"],
            session_id: null,
            task: ["aef"],
            run_id: null,
            raw_include_keywords: null,
            raw_exclude_keywords: null
        ],

        megqc: [
            enabled: true,
            meg_vendor: "elekta"
        ],

        artifacts: [
            // The old config did not run DeepReject. Keep it disabled so this
            // migration does not silently change artifact rejection.
            deepreject: [
                enabled: false
            ],
            find_bad_channels: [
                pyprep: [
                    deviation: [deviation_threshold: 5.0],
                    snr: [:],
                    nan_flat: [:]
                ],
                psd: [
                    std_multiplier: 6
                ],
                osl: [
                    ref_meg: "auto",
                    significance_level: 0.05
                ],
                mne: [
                    find_bad_channels_lof: [
                        n_neighbors: 20,
                        picks: "mag",
                        metric: "euclidean",
                        threshold: 1.5
                    ]
                ]
            ],
            find_bad_segments: [
                keep_existing_annotations: false,
                osl: [
                    segment_len: 1000
                ],
                mne: [
                    annotate_muscle_zscore: [
                        ch_type: "mag",
                        threshold: 12
                    ]
                ]
            ],
            interpolate_bads: false,
            artifact_images_enabled: true,
            meg_vendor: "elekta"
        ],

        // "elekta" is the current canonical name for the old "neuromag"
        // template family used by this dataset.
        ic_label: [
            ICA_classify: [
                meg_vendor: "elekta"
            ]
        ],

        bem: [
            ico: 4,
            conductivity: [0.3]
        ],

        coreg: [
            visualize: true,
            omit_head_shape_points: 1,
            grow_hair: 0.0,
            icp: [
                n_iterations: 200,
                lpa_weight: 1.0,
                nasion_weight: 10.0,
                rpa_weight: 1.0,
                hsp_weight: 10.0,
                eeg_weight: 0.0,
                hpi_weight: 1.0
            ],
            finetune_icp: [
                n_iterations: 200,
                lpa_weight: 0.0,
                nasion_weight: 0.0,
                rpa_weight: 0.0,
                hsp_weight: 10.0,
                eeg_weight: 0.0,
                hpi_weight: 0.0
            ]
        ],

        // Level 3: settings specific to the imported aef recordings.
        recordings: [
            aef: [
                match: [
                    task: "aef"
                ],

                epochs: [
                    preproc: [],
                    task_type: "task",
                    resting: [
                        fixed_length_duration: 2.0
                    ],
                    event_source: "find_events",
                    event_time_shift_sec: 0.0,
                    exclude_event_id: null,
                    autoreject: false,
                    interpolate_bads: false,
                    drop_bad_channels: false,
                    event_file: [
                        trial_type: null
                    ],
                    find_events: [
                        stim_channel: null,
                        shortest_event: 1,
                        min_duration: 0.0
                    ],
                    epochs: [
                        event_id: null,
                        tmin: -0.2,
                        tmax: 0.8,
                        reject_by_annotation: true,
                        picks: "meg",
                        baseline: null,
                        reject: [mag: 4e-12],
                        preload: true,
                        detrend: null
                    ]
                ],

                covariance: [
                    visualize: true,
                    type: "epochs",
                    raw_covariance_task_id: "emptr",
                    event_source: "find_events",
                    event_time_shift_sec: 0.0,
                    compute_raw_covariance: [
                        tmin: 0,
                        tmax: null,
                        method: "auto",
                        reject: [mag: 4e-12],
                        reject_by_annotation: true,
                        rank: "info"
                    ],
                    find_events: [
                        stim_channel: null,
                        shortest_event: 1,
                        min_duration: 0.0
                    ],
                    epochs: [
                        event_id: null,
                        tmin: -0.2,
                        tmax: 0.0,
                        picks: "mag",
                        baseline: null,
                        preload: true,
                        detrend: null,
                        reject_by_annotation: true
                    ],
                    covariance: [
                        tmin: null,
                        tmax: null,
                        rank: null
                    ]
                ],

                forward: [
                    epoch_label: "wdonset",
                    surface: "white",
                    spacing: "ico4"
                ],

                source: [
                    type: "epochs",
                    visualize: true,
                    source_methods: ["dSPM"],
                    data_type: "meg",
                    spacing: "ico4",
                    epoch_label: "wdonset",
                    dSPM: [
                        inverse_operator: [
                            loose: "auto",
                            depth: 0.8,
                            fixed: "auto",
                            rank: [meg: 67]
                        ],
                        apply_inverse: [
                            lambda2: 0.1111111111,
                            method: "dSPM",
                            pick_ori: "normal"
                        ]
                    ],
                    LCMV: [
                        n_rank: 50,
                        cov_tmin: 0.01,
                        cov_tmax: 0.4,
                        make_lcmv: [
                            reg: 0.05,
                            pick_ori: null,
                            rank: [meg: 50],
                            weight_norm: "unit-noise-gain-invariant"
                        ]
                    ]
                ]
            ]
        ]
    ]
]
